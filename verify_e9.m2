-- drop zero coefficients
nz = select(keys acc, k -> acc#k != 0);
<< "nonzero monomials in reconstructed sum: " << #nz << endl;

-- target e_9(x,y) = ((((((((x y)y)y)y)y)y)y)y)y  (left comb, 9 y''s)
e9 = "x"; for i from 1 to 9 do e9 = {e9, "y"};
e9key = canonStr e9;
-- equality: reconstructed sum has exactly the single monomial e9 with coeff 1
ok = (#nz == 1) and (nz#0 === e9key) and (acc#e9key == 1);
<< "e9 monomial: " << e9key << endl;
<< "reconstructed coeff on e9: " << (if acc#?e9key then acc#e9key else 0) << endl;
<< "CERTIFICATE VERIFIES (sum == e_9 exactly): " << ok << endl;
if not ok then error "9-Engel certificate verification failed";
